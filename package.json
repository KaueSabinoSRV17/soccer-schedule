{
  "name": "soccer-headsup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral daily soccer fixture planner",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "dev": "tsc && node dist/src/cli.js",
    "calendar:authorize": "tsc && node dist/src/calendar-auth.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit",
    "gcp-build": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^186.0.0"
  },
  "main": "dist/src/review-worker.js"
}
